# Defaults for `npm run dev` (committed, no secrets: VITE_* values end up in the bundle).
# Override on your machine in .env.local (git-ignored).

# true  = mock API in the browser (no back-end needed, demo: demo@keldrith.dev / demo-password)
# false = real back-end through the Vite proxy (/api → http://localhost:5080)
VITE_USE_MOCKS=true
